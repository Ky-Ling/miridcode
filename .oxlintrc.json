{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "react", "vitest"],
  "jsPlugins": ["./scripts/oxlint-plugin.js"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": "off",
    "typescript/consistent-return": "off"
  },
  "env": {
    "builtin": true
  },
  "overrides": [
    {
      "files": ["packages/*/src/**/*.{ts,tsx}"],
      "rules": {
        "miridcode/blank-line-before-control-flow": "error",
        "miridcode/blank-line-before-return": "error",
        "miridcode/prefer-es-toolkit": "error",
        "miridcode/arrow-function": "error",
        "react/no-multi-comp": "error",
        "eslint/arrow-body-style": ["error", "as-needed"],
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "group": ["es-toolkit", "es-toolkit/*"], "message": "Import from \"@/lib/utils\"." }
            ],
            "paths": [
              {
                "name": "react",
                "importNames": ["memo", "useCallback", "useMemo"],
                "message": "React Compiler memoizes this for you."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/*/src/**/*.tsx"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "group": ["es-toolkit", "es-toolkit/*"], "message": "Import from \"@/lib/utils\"." }
            ],
            "paths": [
              {
                "name": "react",
                "importNames": [
                  "default",
                  "memo",
                  "useCallback",
                  "useEffect",
                  "useImperativeHandle",
                  "useInsertionEffect",
                  "useLayoutEffect",
                  "useMemo",
                  "useReducer",
                  "useRef",
                  "useState",
                  "useSyncExternalStore"
                ],
                "message": "Move this into a use-<name>.ts hook. React Compiler handles memoization."
              },
              {
                "name": "@opentui/react",
                "importNames": [
                  "useAnimationTick",
                  "useAppContext",
                  "useBlur",
                  "useEffectEvent",
                  "useFocus",
                  "useKeyboard",
                  "useOnResize",
                  "usePaste",
                  "useRenderer",
                  "useSelectionHandler",
                  "useTerminalDimensions",
                  "useTimeline"
                ],
                "message": "Move this hook into a use-<name>.ts hook."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/*/src/lib/utils.ts"],
      "rules": {
        "eslint/no-restricted-imports": "off"
      }
    },
    {
      "files": ["packages/*/**/*.{test,spec}.{ts,tsx,mts,cts,js,jsx,mjs,cjs}"],
      "rules": {
        "miridcode/no-ui-tests": "error",
        "miridcode/test-location": "error",
        "vitest/consistent-test-it": ["error", { "fn": "it", "withinDescribe": "it" }],
        "vitest/expect-expect": "error",
        "vitest/no-disabled-tests": "error",
        "vitest/no-focused-tests": "error",
        "vitest/no-standalone-expect": "error",
        "vitest/valid-expect": "error",
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["es-toolkit", "es-toolkit/*"],
                "message": "Import from \"@/lib/utils\"."
              },
              {
                "group": ["@opentui/**", "react", "react/**"],
                "message": "Test hooks through \"@/lib/render-hook\". Components stay untested."
              },
              {
                "group": ["**/use-*", "@/hooks/**", "**/render-hook"],
                "message": "Hooks are tested in their own use-<name>.test.ts file."
              }
            ],
            "paths": [{ "name": "bun:test", "message": "Tests run on Vitest." }]
          }
        ]
      }
    },
    {
      "files": ["packages/*/src/**/__test__/use-*.test.{ts,tsx}"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["es-toolkit", "es-toolkit/*"],
                "message": "Import from \"@/lib/utils\"."
              },
              {
                "group": ["@opentui/**", "react", "react/**"],
                "message": "Test hooks through \"@/lib/render-hook\". Components stay untested."
              }
            ],
            "paths": [{ "name": "bun:test", "message": "Tests run on Vitest." }]
          }
        ]
      }
    }
  ]
}
