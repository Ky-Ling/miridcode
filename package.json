{
  "name": "miridcode",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev:cli": "bun run --watch packages/cli/src/index.tsx",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "oxlint . --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint . --fix --no-error-on-unmatched-pattern",
    "start:cli": "bun run packages/cli/src/index.tsx",
    "typecheck": "bun run --filter './packages/*' typecheck && tsc --noEmit"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.4.4",
    "babel-plugin-react-compiler": "1.0.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2"
  }
}
